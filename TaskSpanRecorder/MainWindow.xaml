<ui:FluentWindow x:Class="TaskSpanRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:TaskSpanRecorder"
        xmlns:controls="clr-namespace:TaskSpanRecorder.Controls"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="600" Width="800"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Task Span Recorder" />

        <StackPanel Grid.Row="1" Margin="20,10">
            <TextBlock Text="{Binding CurrentStatusText}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Text="Task Categories:" FontWeight="SemiBold" Margin="0,0,0,5"/>

            <StackPanel Orientation="Horizontal">
                <ComboBox
                    ItemsSource="{Binding TaskCategories}"
                    DisplayMemberPath="Name"
                    SelectedItem="{Binding SelectedTaskCategory}"
                    Width="200" Margin="0,0,10,0" />
                
                <ui:Button Content="開始 / 切り替え" Icon="{ui:SymbolIcon Symbol=Play24}" Command="{Binding StartSelectedTaskCommand}" Appearance="Primary" Margin="0,0,10,0"/>

                <ui:Button Content="休憩 / 中断" Icon="{ui:SymbolIcon Symbol=Pause24}" Command="{Binding SwitchToIdleCommand}" Appearance="Secondary" Margin="0,0,10,0"/>

                <ui:Button Content="新規カテゴリ" Icon="{ui:SymbolIcon Symbol=Add24}" Command="{Binding AddTaskCategoryCommand}" Appearance="Transparent"/>
            </StackPanel>
        </StackPanel>

        <TabControl Grid.Row="2" Margin="20,0,20,20">

            <TabItem Header="タイムライン" FontSize="14" FontWeight="SemiBold">
                <controls:TimelineControl Margin="0,10,0,0"/>
            </TabItem>

            <TabItem Header="詳細データ (履歴)" FontSize="14" FontWeight="SemiBold">
                <ui:DataGrid ItemsSource="{Binding TaskSpans}" AutoGenerateColumns="False" Margin="0,10,0,0" IsReadOnly="True">
                    <ui:DataGrid.Columns>
                        <DataGridTextColumn Header="日付" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="100"/>
                        <DataGridTextColumn Header="カテゴリ" Binding="{Binding TaskCategory.Name}" Width="*"/>
                        <DataGridTextColumn Header="開始" Binding="{Binding StartTime, StringFormat=HH:mm:ss}" Width="100"/>
                        <DataGridTextColumn Header="終了" Binding="{Binding EndTime, StringFormat=HH:mm:ss}" Width="100"/>
                    </ui:DataGrid.Columns>
                </ui:DataGrid>
            </TabItem>

            <TabItem Header="集計 (グラフ)" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15" HorizontalAlignment="Center">
                        <TextBlock Text="集計期間:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <DatePicker SelectedDate="{Binding StartDate}" Width="130" />
                        <TextBlock Text="〜" VerticalAlignment="Center" Margin="10,0"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Width="130" />

                        <ui:Button Content="更新" Icon="{ui:SymbolIcon ArrowRepeatAll24}" Command="{Binding UpdateAggregationCommand}" Margin="15,0,0,0" Appearance="Secondary"/>
                    </StackPanel>

                    <lvc:PieChart Grid.Row="1" Series="{Binding CategoryPieSeries}" InitialRotation="-90" />
                </Grid>
            </TabItem>

        </TabControl>

        <ContentPresenter x:Name="RootContentDialogPresenter" Grid.RowSpan="3" />
    </Grid>
</ui:FluentWindow>
